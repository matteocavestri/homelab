global:
  resolve_timeout: 5m

route:
  receiver: default
  group_by: [alertname, job, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

  routes:
    - matchers:
        - severity = info
      receiver: info
      group_wait: 30m
      group_interval: 2h
      repeat_interval: 24h

    - matchers:
        - severity = critical
      receiver: critical
      group_wait: 10s
      repeat_interval: 1h

    - matchers:
        - severity = warning
      receiver: warning
      group_wait: 10m
      group_interval: 1h
      repeat_interval: 8h

receivers:
  - name: default
    webhook_configs:
      - url: "http://ntfy:80/alerts?template=alertmanager&priority=default&tags=bell"
        send_resolved: true
        http_config:
          basic_auth:
            username: alertmanager
            password: {{ vault_alertmanager.ntfy_password }}

  - name: info
    webhook_configs:
      - url: "http://ntfy:80/alerts-info?template=alertmanager&priority=low&tags=information_source"
        send_resolved: false
        http_config:
          basic_auth:
            username: alertmanager
            password: {{ vault_alertmanager.ntfy_password }}

  - name: critical
    webhook_configs:
      - url: "http://ntfy:80/alerts-critical?template=alertmanager&priority=urgent&tags=rotating_light"
        send_resolved: true
        http_config:
          basic_auth:
            username: alertmanager
            password: {{ vault_alertmanager.ntfy_password }}

  - name: warning
    webhook_configs:
      - url: "http://ntfy:80/alerts-warning?template=alertmanager&priority=high&tags=warning"
        send_resolved: true
        http_config:
          basic_auth:
            username: alertmanager
            password: {{ vault_alertmanager.ntfy_password }}

inhibit_rules:
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: [alertname, instance]
