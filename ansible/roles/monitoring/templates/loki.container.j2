[Unit]
Description=Grafana Loki
PartOf=monitoring.target
After=monitoring.target
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Container]
Image={{ versions.loki.image }}:{{ versions.loki.tag }}
ContainerName=loki
Volume=loki-data:/data/loki
Volume=%h/.config/infrastructure/monitoring/loki/loki.yaml:/etc/loki/loki.yaml:ro,Z
Network=monitoring.network
Exec=-config.file=/etc/loki/loki.yaml
NoNewPrivileges=true
AutoUpdate=registry
StopSignal=SIGTERM
StopTimeout=30

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=60
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loki
Slice=monitoring.slice

[Install]
WantedBy=monitoring.target
