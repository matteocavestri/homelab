[Unit]
Description=Crawl4AI - Web Crawling Service
PartOf=ai.target
After=ai.target
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Container]
Image={{ versions.crawl4ai.image }}:{{ versions.crawl4ai.tag }}
ContainerName=crawl4ai
Network=ai.network
Volume=crawl4ai-data:/home/appuser/.crawl4ai
EnvironmentFile=%h/.config/ai/crawl4ai/crawl4ai.env
PodmanArgs=--shm-size=1g
NoNewPrivileges=true
AutoUpdate=registry
StopSignal=SIGTERM
StopTimeout=30

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=180
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crawl4ai
Slice=ai.slice

[Install]
WantedBy=ai.target
