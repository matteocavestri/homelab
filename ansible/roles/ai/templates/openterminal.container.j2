[Unit]
Description=Open Terminal - Remote Shell for AI Agents
PartOf=ai.target
After=ai.target
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Container]
Image={{ versions.openterminal.image }}:{{ versions.openterminal.tag }}
ContainerName=openterminal
Network=ai.network
Volume=open-terminal-data:/home/user
EnvironmentFile=%h/.config/ai/openterminal/openterminal.env
AutoUpdate=registry

NoNewPrivileges=true
StopSignal=SIGTERM
StopTimeout=30

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=120
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=open-terminal
Slice=ai.slice

[Install]
WantedBy=ai.target
