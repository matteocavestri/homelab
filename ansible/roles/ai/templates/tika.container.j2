[Unit]
Description=Tika - Document and Image Analysis Service
PartOf=ai.target
After=ai.target
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Container]
Image={{ versions.tika.image }}:{{ versions.tika.tag }}
ContainerName=tika
Network=ai.network
Volume=tika-data:/root/.tika
EnvironmentFile=%h/.config/ai/tika/tika.env
SecurityLabelDisable=true
NoNewPrivileges=true
AutoUpdate=registry
StopSignal=SIGTERM
StopTimeout=30

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=180
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tika
Slice=ai.slice

[Install]
WantedBy=ai.target
