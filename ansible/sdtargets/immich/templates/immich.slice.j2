[Unit]
Description=Immich Slice
Before=slices.target

[Slice]
# CPU
CPUWeight={{ immich_slice.cpu_weight }}
StartupCPUWeight={{ immich_slice.startup_cpu_weight }}
CPUQuota={{ immich_slice.cpu_quota }}
{% if immich_slice.allowed_cpus is defined and immich_slice.allowed_cpus %}
AllowedCPUs={{ immich_slice.allowed_cpus }}
{% endif %}
# Memory
MemoryMin={{ immich_slice.memory_min }}
MemoryLow={{ immich_slice.memory_low }}
MemoryHigh={{ immich_slice.memory_high }}
MemoryMax={{ immich_slice.memory_max }}
MemorySwapMax={{ immich_slice.memory_swap_max }}
