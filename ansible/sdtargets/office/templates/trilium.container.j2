[Unit]
Description=Trilium Notes
PartOf=office.target
After=office.target
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Container]
Image={{ versions.trilium.image }}:{{ versions.trilium.tag }}
ContainerName=trilium
Network=office.network
Network=ai.network
PublishPort=127.0.0.1:8084:8080
Volume=trilium-data:/home/node/trilium-data
EnvironmentFile=%h/.config/office/trilium.env
NoNewPrivileges=true
AutoUpdate=registry
StopSignal=SIGTERM
StopTimeout=30

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=60
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trilium
Slice=office.slice

[Install]
WantedBy=office.target
