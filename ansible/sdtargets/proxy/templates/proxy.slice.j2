[Unit]
Description=Proxy Slice
Before=slices.target

[Slice]
# CPU
CPUWeight={{ proxy_slice.cpu_weight }}
StartupCPUWeight={{ proxy_slice.startup_cpu_weight }}
CPUQuota={{ proxy_slice.cpu_quota }}
{% if proxy_slice.allowed_cpus is defined and proxy_slice.allowed_cpus %}
AllowedCPUs={{ proxy_slice.allowed_cpus }}
{% endif %}
# Memory
MemoryMin={{ proxy_slice.memory_min }}
MemoryLow={{ proxy_slice.memory_low }}
MemoryHigh={{ proxy_slice.memory_high }}
MemoryMax={{ proxy_slice.memory_max }}
MemorySwapMax={{ proxy_slice.memory_swap_max }}
