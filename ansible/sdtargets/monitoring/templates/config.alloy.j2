// Metrics scraping -> Mimir

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"

    queue_config {
      max_samples_per_send = 10000
      max_shards           = 5
      capacity             = 20000
    }
  }
  external_labels = {
    cluster  = "leonardo",
    instance = "leonardo",
  }
}

prometheus.scrape "node" {
  targets = [{
    __address__ = "node-exporter:9100",
    instance    = "leonardo",
  }]
  job_name        = "node"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

