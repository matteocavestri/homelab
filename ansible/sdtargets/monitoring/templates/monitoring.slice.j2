[Unit]
Description=Monitoring Slice
Before=slices.target

[Slice]
# CPU
CPUWeight={{ monitoring_slice.cpu_weight }}
StartupCPUWeight={{ monitoring_slice.startup_cpu_weight }}
CPUQuota={{ monitoring_slice.cpu_quota }}
{% if monitoring_slice.allowed_cpus is defined and monitoring_slice.allowed_cpus %}
AllowedCPUs={{ monitoring_slice.allowed_cpus }}
{% endif %}
# Memory
MemoryMin={{ monitoring_slice.memory_min }}
MemoryLow={{ monitoring_slice.memory_low }}
MemoryHigh={{ monitoring_slice.memory_high }}
MemoryMax={{ monitoring_slice.memory_max }}
MemorySwapMax={{ monitoring_slice.memory_swap_max }}
