[Unit]
Description=Alertmanager
PartOf=monitoring.target
After=monitoring.target mimir.service ntfy.service
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Container]
Image={{ versions.alertmanager.image }}:{{ versions.alertmanager.tag }}
ContainerName=alertmanager
Volume=alertmanager-data:/alertmanager
Volume=%h/.config/infrastructure/monitoring/alertmanager/alertmanager.yaml:/etc/alertmanager/alertmanager.yaml:ro,Z
Network=monitoring.network
Exec=--config.file=/etc/alertmanager/alertmanager.yaml --storage.path=/alertmanager --web.listen-address=0.0.0.0:9093
NoNewPrivileges=true
AutoUpdate=registry
StopSignal=SIGTERM
StopTimeout=30

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=30
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alertmanager
Slice=monitoring.slice

[Install]
WantedBy=monitoring.target
