[Unit]
Description=Jellyfin Slice
Before=slices.target

[Slice]
# CPU
CPUWeight={{ jellyfin_slice.cpu_weight }}
StartupCPUWeight={{ jellyfin_slice.startup_cpu_weight }}
CPUQuota={{ jellyfin_slice.cpu_quota }}
{% if jellyfin_slice.allowed_cpus is defined and jellyfin_slice.allowed_cpus %}
AllowedCPUs={{ jellyfin_slice.allowed_cpus }}
{% endif %}
# Memory
MemoryMin={{ jellyfin_slice.memory_min }}
MemoryLow={{ jellyfin_slice.memory_low }}
MemoryHigh={{ jellyfin_slice.memory_high }}
MemoryMax={{ jellyfin_slice.memory_max }}
MemorySwapMax={{ jellyfin_slice.memory_swap_max }}
