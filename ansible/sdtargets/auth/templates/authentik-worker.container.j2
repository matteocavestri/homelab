[Unit]
Description=Authentik Worker
PartOf=auth.target
After=auth.target authentik-postgres.service
Requires=authentik-postgres.service
OnFailure=notify-failure@%n.service
OnSuccess=notify-recovery@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Container]
{% if versions.authentik.pin_digest is defined %}Image={{ versions.authentik.image }}@{{ versions.authentik.pin_digest }}
{% else %}Image={{ versions.authentik.image }}:{{ versions.authentik.tag }}
{% endif %}ContainerName=authentik-worker
Exec=worker
Volume=authentik-media:/media
Volume=authentik-custom-templates:/templates
Volume=authentik-certs:/certs
Network=authentik.network
EnvironmentFile=%h/.config/infrastructure/auth/authentik/authentik.env
NoNewPrivileges=true
AutoUpdate=registry

HealthCmd=ak healthcheck || exit 1
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
HealthOnFailure=kill

StopSignal=SIGTERM
StopTimeout=30

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=authentik-worker
Slice=auth.slice

[Install]
WantedBy=auth.target
