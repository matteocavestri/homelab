[Unit]
Description=Arr Slice
Before=slices.target

[Slice]
# CPU
CPUWeight={{ arr_slice.cpu_weight }}
StartupCPUWeight={{ arr_slice.startup_cpu_weight }}
CPUQuota={{ arr_slice.cpu_quota }}
{% if arr_slice.allowed_cpus is defined and arr_slice.allowed_cpus %}
AllowedCPUs={{ arr_slice.allowed_cpus }}
{% endif %}
# Memory
MemoryMin={{ arr_slice.memory_min }}
MemoryLow={{ arr_slice.memory_low }}
MemoryHigh={{ arr_slice.memory_high }}
MemoryMax={{ arr_slice.memory_max }}
MemorySwapMax={{ arr_slice.memory_swap_max }}
