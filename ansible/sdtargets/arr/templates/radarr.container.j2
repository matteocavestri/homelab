[Unit]
Description=Radarr - Movie Manager
After=gluetun.service
Requires=gluetun.service
OnFailure=notify-failure@%n.service

[Container]
Image={{ versions.radarr.image }}:{{ versions.radarr.tag }}
ContainerName=radarr
Network=container:gluetun
Volume=radarr-config:/config
Volume=/mnt/Downloads:/downloads:z
Volume=/mnt/Media/Film:/movies:z
EnvironmentFile=%h/.config/media/arr/radarr.env
NoNewPrivileges=true
AutoUpdate=registry

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=radarr
Slice=arr.slice

[Install]
WantedBy=arr.target
