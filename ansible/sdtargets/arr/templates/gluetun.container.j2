[Unit]
Description=Gluetun VPN Gateway
After=podman-user-wait-network-online.service
OnFailure=notify-failure@%n.service

[Container]
Image={{ versions.gluetun.image }}:{{ versions.gluetun.tag }}
ContainerName=gluetun
Network=arr.network
AddCapability=NET_ADMIN
AddDevice=/dev/net/tun:/dev/net/tun
SecurityLabelDisable=true
Volume=gluetun-config:/gluetun
EnvironmentFile=%h/.config/media/arr/gluetun.env
PublishPort=127.0.0.1:8888:8888
PublishPort=127.0.0.1:8082:8082
PublishPort=127.0.0.1:6789:6789
PublishPort=127.0.0.1:7878:7878
PublishPort=127.0.0.1:8989:8989
PublishPort=127.0.0.1:8686:8686
PublishPort=127.0.0.1:9696:9696
PublishPort=127.0.0.1:8191:8191
PublishPort=127.0.0.1:1867:1867
NoNewPrivileges=false
AutoUpdate=registry

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gluetun
Slice=arr.slice

[Install]
WantedBy=arr.target
