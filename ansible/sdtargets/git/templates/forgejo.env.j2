TZ={{ common.timezone }}
FORGEJO__DEFAULT__APP_NAME={{ forgejo.app_name }}
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__security__SECRET_KEY={{ vault_forgejo.secret_key }}
FORGEJO__security__INTERNAL_TOKEN={{ vault_forgejo.internal_token }}
FORGEJO__database__DB_TYPE=postgres
FORGEJO__database__HOST=forgejo-postgres:5432
FORGEJO__database__NAME={{ forgejo_postgres.db }}
FORGEJO__database__USER={{ forgejo_postgres.user }}
FORGEJO__database__PASSWD={{ vault_forgejo.postgres_password }}
FORGEJO__server__DOMAIN={{ forgejo.domain }}
FORGEJO__server__ROOT_URL={{ forgejo.root_url }}
FORGEJO__server__HTTP_PORT={{ forgejo.http_port }}
FORGEJO__server__SSH_DOMAIN={{ forgejo.domain }}
FORGEJO__server__SSH_PORT={{ forgejo.ssh_port }}
FORGEJO__server__SSH_LISTEN_PORT={{ forgejo.ssh_port }}
# Only OIDC (Authentik) sign-ups; the local password form stays for the admin.
FORGEJO__service__DISABLE_REGISTRATION=false
FORGEJO__service__ALLOW_ONLY_EXTERNAL_REGISTRATION=true
FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION=true
FORGEJO__oauth2_client__USERNAME=preferred_username
FORGEJO__oauth2_client__ACCOUNT_LINKING=login
FORGEJO__actions__ENABLED=true
FORGEJO__log__LEVEL=Info
