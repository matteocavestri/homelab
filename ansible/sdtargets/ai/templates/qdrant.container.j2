[Unit]
Description=Qdrant - Vector Database
PartOf=ai.target
After=ai.target
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Container]
Image={{ versions.qdrant.image }}:{{ versions.qdrant.tag }}
ContainerName=qdrant
Network=ai.network
PublishPort=127.0.0.1:6333:6333
Volume=qdrant-data:/qdrant/storage
EnvironmentFile=%h/.config/ai/qdrant/qdrant.env
NoNewPrivileges=true
AutoUpdate=registry
StopSignal=SIGTERM
StopTimeout=30

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qdrant
Slice=ai.slice

[Install]
WantedBy=ai.target
