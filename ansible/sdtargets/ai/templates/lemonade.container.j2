[Unit]
Description=Lemonade - Local LLM Server
PartOf=ai.target
After=ai.target
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Container]
Image={{ versions.lemonade.image }}:{{ versions.lemonade.tag }}
ContainerName=lemonade
Network=ai.network
PublishPort=127.0.0.1:13305:13305
Volume=lemonade-cache:/opt/lemonade/.cache/huggingface
Volume=lemonade-llama:/opt/lemonade/llama
Volume=lemonade-data:/opt/lemonade/.cache/lemonade
Volume=lemonade-config:/opt/lemonade/.config/lemonade
EnvironmentFile=%h/.config/ai/lemonade/lemonade.env
SecurityLabelDisable=true
AddDevice=nvidia.com/gpu=all
NoNewPrivileges=true
AutoUpdate=registry
StopSignal=SIGTERM
StopTimeout=30

[Service]
Restart=always
RestartSec=10
RestartSteps=3
RestartMaxDelaySec=60
TimeoutStartSec=180
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lemonade
Slice=ai.slice

[Install]
WantedBy=ai.target
